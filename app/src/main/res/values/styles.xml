<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 虚拟键盘按键 -->
    <style name="KbKey" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_kb_key</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="KbKey.Small">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 快捷键修饰键开关（Chip 风格，可选中高亮） -->
    <style name="ShortcutChip">
        <item name="android:background">@drawable/bg_kb_key</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 快捷键按钮（会话内快捷键栏） -->
    <style name="ShortcutBtn" parent="KbKey.Small">
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">10dp</item>
    </style>


    <!-- v1.3.0 设置页样式 -->
    <style name="SettingsSection">
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="SettingsRow">
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
