<?xml version="1.0" encoding="utf-8"?>
<!-- 添加快捷键：名称 + 修饰键开关 + 主键选择 + 物理键盘录制提示 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shortcut_name"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shortcut_name_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="#55FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/shortcut_modifiers"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mod_ctrl" style="@style/ShortcutChip"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginEnd="6dp" android:layout_weight="1"
                android:text="Ctrl" />

            <TextView
                android:id="@+id/mod_alt" style="@style/ShortcutChip"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginEnd="6dp" android:layout_weight="1"
                android:text="Alt" />

            <TextView
                android:id="@+id/mod_shift" style="@style/ShortcutChip"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginEnd="6dp" android:layout_weight="1"
                android:text="Shift" />

            <TextView
                android:id="@+id/mod_super" style="@style/ShortcutChip"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Super" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_key" style="@style/ShortcutChip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_pick_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/shortcut_pick_key" />

        <TextView
            android:id="@+id/txt_recorded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/selkies_teal"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/shortcut_record_hint"
            android:textColor="#66FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
