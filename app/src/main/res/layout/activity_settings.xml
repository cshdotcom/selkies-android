<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:title="@string/title_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ====== 画质 ====== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_quality"
                android:textColor="#1B4FD8"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvBitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/sbBitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hint_fps"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <Switch
                android:id="@+id/swMatchRes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sw_match_res" />

            <!-- ====== 行为 ====== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/section_behavior"
                android:textColor="#1B4FD8"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Switch
                android:id="@+id/swAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sw_audio" />
            <Switch
                android:id="@+id/swClipboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sw_clipboard" />
            <Switch
                android:id="@+id/swReconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sw_reconnect" />
            <Switch
                android:id="@+id/swKeepOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sw_keep_on" />
            <Switch
                android:id="@+id/swAutoKb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sw_auto_kb" />

            <!-- ====== 手势 ====== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/section_gesture"
                android:textColor="#1B4FD8"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hint_long_press"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spLongPress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <Switch
                android:id="@+id/swNaturalScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sw_natural" />
            <TextView
                android:id="@+id/tvScrollStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/sbScrollStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ====== 密钥管理 ====== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/section_security"
                android:textColor="#1B4FD8"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnClearPasswords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#D32F2F"
                android:text="@string/btn_clear_pw" />

            <!-- ====== 关于 ====== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/section_about"
                android:textColor="#1B4FD8"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
