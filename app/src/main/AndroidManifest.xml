<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络访问：连接 Selkies 服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络状态：断线检测与重连提示 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 保持屏幕常亮：远程会话期间 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 麦克风上行（远端虚拟麦克风）：运行时请求 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 摄像头上行（远端虚拟摄像头）：运行时请求 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 9 及以下保存下载文件到公共 Downloads -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".SelkiesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Selkies">

        <!-- 服务器列表（主入口） -->
        <activity
            android:name=".ui.ServerListActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 服务器编辑 -->
        <activity
            android:name=".ui.ServerEditActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 远程会话（横竖屏自由切换，自行处理配置变更避免重建导致断线） -->
        <activity
            android:name=".ui.session.SessionActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode|keyboard"
            android:screenOrientation="fullSensor"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="false" />

        <!-- 设置 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/settings_title" />

        <!-- 远端文件浏览器 -->
        <activity
            android:name=".ui.FilesActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/panel_files" />

        <!-- 快捷键管理 -->
        <activity
            android:name=".ui.ShortcutsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/shortcuts_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- 远程应用启动器（v1.2.0） -->
        <activity
            android:name=".ui.AppsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/apps_title"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
