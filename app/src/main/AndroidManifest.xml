<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络访问：连接 Selkies 服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络状态：断线检测与重连提示 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 保持屏幕常亮：远程会话期间 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 剪贴板读取：双向同步（Android 10+ 系统限制后台读取，会话中前台读取） -->

    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".SelkiesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Selkies">

        <!-- 服务器列表（主入口） -->
        <activity
            android:name=".ui.ServerListActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 服务器编辑 -->
        <activity
            android:name=".ui.ServerEditActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 远程会话（横竖屏自由切换，自行处理配置变更避免重建导致断线） -->
        <activity
            android:name=".ui.session.SessionActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:screenOrientation="fullSensor"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="false" />

        <!-- 设置 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/settings_title" />
    </application>
</manifest>
